<Project Sdk="Microsoft.NET.Sdk">

  <!-- Contracts/ is its own project (BankOps.Modules.Audit.Contracts) so other modules can
       reference the published interface without pulling in this module's Infrastructure/Api —
       exclude it here so it isn't compiled twice into two different assemblies. -->
  <ItemGroup>
    <Compile Remove="Contracts\**" />
    <None Remove="Contracts\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\contracts\BankOps.Contracts.csproj" />
    <ProjectReference Include="Contracts\BankOps.Modules.Audit.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Class library, not Sdk.Web — but it hosts controllers, so it needs the ASP.NET Core shared
       framework's types ([ApiController], ControllerBase, [Authorize], ...) without pulling in a
       second copy of the runtime. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
